<UserControl x:Class="BDCarRental.Views.BookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             Dialog:DialogParticipation.Register="{Binding}"
             xmlns:local="clr-namespace:BDCarRental.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DataGrid Name="BookingsDataGrid"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Start date"
                                    MinWidth="90"
                                    MaxWidth="90"
                                    Binding="{Binding StartDate, StringFormat='{}{0:dd-MMM-yy}'}"/>
                <DataGridTextColumn Header="End date"
                                    MinWidth="90"
                                    MaxWidth="90"
                                    Binding="{Binding EndDate, StringFormat='{}{0:dd-MMM-yy}'}"/>
                <DataGridTextColumn Header="Car"
                                    MinWidth="150"
                                    MaxWidth="200"
                                    Binding="{Binding BookedCar}"/>
                <DataGridTextColumn Header="Customer"
                                    MinWidth="150"
                                    MaxWidth="200"
                                    Binding="{Binding BookedCustomer}"/>
                <DataGridTextColumn Header="Total cost"
                                    MinWidth="90"
                                    MaxWidth="120"
                                    Binding="{Binding TotalCost}"/>
                <DataGridTemplateColumn MinWidth="100"
                                        MaxWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Margin="5"
                                        Width="80"
                                        Content="Return car"
                                        Style="{DynamicResource AccentedSquareButtonStyle}"
                                        Command="{Binding Path=DataContext.OpenReturnCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
