<UserControl x:Class="CarRentalApp.Views.CarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             Dialog:DialogParticipation.Register="{Binding}"
             xmlns:local="clr-namespace:CarRentalApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="3000" d:DesignWidth="500">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibilityConverter" />
    </UserControl.Resources>
    
    <Grid>
        <DataGrid Name="CarsDataGrid"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Make"
                                    MinWidth="150"
                                    MaxWidth="200"
                                    Binding="{Binding Make}"/>
                <DataGridTextColumn Header="Model"
                                    MinWidth="150"
                                    MaxWidth="200"
                                    Binding="{Binding Model}"/>
                <DataGridTextColumn Header="Year"
                                    MinWidth="75"
                                    MaxWidth="75"
                                    Binding="{Binding Year}"/>
                <DataGridTextColumn Header="Price per day"
                                    MinWidth="110"
                                    MaxWidth="110"
                                    Binding="{Binding Price}"/>
                <DataGridCheckBoxColumn Header="Available"
                                        MinWidth="90"
                                        MaxWidth="90"
                                        Binding="{Binding Availability}"/>
                <DataGridTemplateColumn MinWidth="100"
                                        MaxWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Margin="5"
                                        Content="Book car"
                                        Width="80"
                                        Style="{DynamicResource AccentedSquareButtonStyle}"
                                        Visibility="{Binding Availability, Converter={StaticResource VisibilityConverter}}"
                                        Command="{Binding Path=DataContext.OpenBookingCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding Id}"/>
                            </StackPanel>                            
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
