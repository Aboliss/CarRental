<UserControl x:Class="CarRentalApp.Views.BookingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             Dialog:DialogParticipation.Register="{Binding}"
             xmlns:local="clr-namespace:CarRentalApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Vertical">
            <Label Content="Booking a car"
                   FontSize="24"
                   Margin="0,0,5,0"/>
            <Label Name="BookingCarLabel"
                   FontSize="14"
                   FontStyle="Italic"
                   HorizontalAlignment="Left"/>
        </StackPanel>
        <Label Grid.Row="1"
               Grid.Column="0"
               Content="FirstName"
               VerticalAlignment="Center"/>
        <TextBox Controls:TextBoxHelper.ClearTextButton="True" 
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,5"
                 Name="BookingFirstName"/>
        <Label Grid.Row="2"
               Grid.Column="0"
               Content="LastName"
               VerticalAlignment="Center"/>
        <TextBox Controls:TextBoxHelper.ClearTextButton="True" 
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,5"
                 Name="BookingLastName"/>
        <Label Grid.Row="3"
               Grid.Column="0"
               Content="Start"
               VerticalAlignment="Center"/>
        <DatePicker Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,5"
                    Name="BookingStartDate"/>
        <Label Grid.Row="4"
               Grid.Column="0"
               Content="End"
               VerticalAlignment="Center"/>
        <DatePicker Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,5"
                    Name="BookingEndDate"/>
        <Label Grid.Row="5"
               Grid.Column="0"
               Content="Total"
               VerticalAlignment="Center"/>
        <TextBlock Text="0.00 €"
                   Grid.Row="5"
                   Grid.Column="1"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,5"
                   Name="TotalPrice"/>
        <StackPanel Grid.Row="6"
                    Grid.Column="0"
                    Margin="5,10,5,5">
            <Button Content="Confirm"
                    Name="ConfirmButton"
                    Width="80"
                    HorizontalAlignment="Right"
                    Style="{DynamicResource AccentedSquareButtonStyle}"/>
        </StackPanel>
        <StackPanel Grid.Row="6"
                    Grid.Column="1"
                    Margin="5,10,5,5">
            <Button Content="Cancel"
                    Name="CancelButton"
                    Width="80"
                    Style="{DynamicResource SquareButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
